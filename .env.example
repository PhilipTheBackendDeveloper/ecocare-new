# ==============================================================================
# EcoCare Cleaning Services Limited — Environment Configuration Template
# Copy this file to .env.local for local Vercel serverless development:
#   cp .env.example .env.local
# In Vercel Production: Add these variables in Project Settings -> Environment Variables.
# NEVER commit .env or .env.local containing real production credentials to Git.
# ==============================================================================

# Destination email for quote requests and contact messages
NOTIFICATION_RECIPIENT_EMAIL=ecocaregh1on1@gmail.com

# SMTP Dispatcher Configuration (Optional: Resend, SendGrid, Mailgun, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=notifications@ecocaregh.com
SMTP_FROM_NAME=EcoCare Notifications

# Optional: Third-party Form Backend Fallback (e.g., Formspree / EmailJS)
# If provided, submissions can route directly to Formspree:
# FORMSPREE_ENDPOINT_QUOTE=https://formspree.io/f/your_form_id
# FORMSPREE_ENDPOINT_CONTACT=https://formspree.io/f/your_form_id

